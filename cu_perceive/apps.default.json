[
  {
    "name": "steam",
    "exe": "%ProgramFiles(x86)%\\Steam\\steam.exe"
  },
  {
    "name": "doubao",
    "exe": "%LOCALAPPDATA%\\Doubao\\Application\\Doubao.exe"
  },
  {
    "name": "chrome",
    "exe": "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe"
  },
  {
    "name": "edge",
    "exe": "%ProgramFiles(x86)%\\Microsoft\\Edge\\Application\\msedge.exe"
  },
  {
    "name": "chrome-shadow",
    "exe": "%ProgramFiles%\\Google\\Chrome\\Application\\chrome.exe",
    "args": [
      "--no-first-run",
      "--no-default-browser-check",
      "--disable-sync",
      "--new-window",
      "about:blank"
    ],
    "note": "shadow profile (CU_PERCEIVE_SHADOW_PROFILE_CHROME, default ~/.cu-perceive-trial-chrome-profile); never the main profile"
  }
]
